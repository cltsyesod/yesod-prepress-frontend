# Copie para .env e preencha. O .env nunca vai para o git.

ENVIRONMENT=production
LOG_LEVEL=INFO

# Subdomínio público do analyzer (A record apontando para o IP da VPS).
# O Caddy emite e renova o certificado HTTPS para ele automaticamente.
ANALYZER_DOMAIN=analyzer.seudominio.com.br

# Dois segredos diferentes. Gere cada um com:  openssl rand -hex 32
# INBOUND  = mesmo valor do secret ANALYZER_INBOUND_SECRET na Supabase
# CALLBACK = mesmo valor do secret ANALYZER_CALLBACK_SECRET na Supabase
INBOUND_SIGNING_SECRET=
CALLBACK_SIGNING_SECRET=

# O analyzer só baixa PDFs e só envia callbacks para estes hosts.
ALLOWED_DOWNLOAD_HOSTS=rfnckjmkfkphwnjpyhdz.supabase.co
ALLOWED_CALLBACK_HOSTS=rfnckjmkfkphwnjpyhdz.supabase.co

VALKEY_URL=redis://valkey:6379/0
